<resources>
    <style name="Theme.QrLinkSample.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/action</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.QrLinkSample" parent="Theme.QrLinkSample.Base" />
    <style name="Heading">
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">34sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="SecondaryText">
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="ActionButton" parent="android:Widget.Material.Light.Button">
        <item name="android:backgroundTint">@color/action</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">54dp</item>
    </style>
    <style name="TextAction" parent="android:Widget.Material.Light.Button.Borderless">
        <item name="android:textColor">@color/action</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="FieldLabel" parent="SecondaryText">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="FieldValue">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
